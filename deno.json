{
  "workspace": [
    "./server",
    "./client",
    "./bundler",
    "./tests",
    "./packages/session_storage_kv",
    "./packages/dpop_session_middleware",
    "./packages/protocol"
  ],
  "tasks": {
    "dev": "deno task --cwd server dev",
    "serve": "deno task --cwd server serve",
    "bundle": "deno task --cwd bundler build",
    "db": "deno run -A db/cli.ts",
    "migrate": "deno run -A db/migrate.ts",
    "keygen": "deno run server/scripts/keygen.ts",
    "test": "deno test -P --ignore=tests && deno task --cwd tests test",
    "check": "deno check && deno lint && deno fmt --check"
  },
  "permissions": {
    "default": {}
  },
  "test": {
    "permissions": "default"
  },
  "fmt": {
    "exclude": [
      "docs/"
    ]
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@kuboon/*"
    ]
  },
  "unstable": [
    "bundle"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/ui"
  },
  "imports": {
    "daisyui": "npm:daisyui@^5.5.19",
    "tailwindcss": "npm:tailwindcss@^4.1.18",
    "@kuboon/remix-data-table-sqlite-turso": "jsr:@kuboon/remix-data-table-sqlite-turso@^0.3.0",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "deploy": {
    "org": "kbn",
    "app": "game-center"
  }
}
