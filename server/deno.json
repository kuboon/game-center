{
  "tasks": {
    "bundle": "deno task --cwd ../bundler build",
    "dev": "deno task bundle && deno serve -P --watch ./router.ts",
    "serve": "deno serve -P ./router.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@game-center/protocol": "jsr:@game-center/protocol@^0.1.0",
    "@remix-run/component": "npm:@remix-run/component@^1.0.0",
    "@remix-run/fetch-router": "npm:@remix-run/fetch-router@1.0.0",
    "@remix-run/response": "npm:@remix-run/response@1.0.0",
    "@remix-run/static-middleware": "npm:@remix-run/static-middleware@1.0.0",
    "@libsql/client": "npm:@libsql/client@^0.17.4",
    "jose": "jsr:@panva/jose@^6.2.3",
    "@kuboon/kv": "jsr:@kuboon/kv@^0.2.0",
    "@kuboon/dpop": "jsr:@kuboon/dpop@^0.2.0",
    "@remix-run/session": "npm:@remix-run/session@^1.0.0",
    "@game-center/session-storage-kv": "jsr:@game-center/session-storage-kv@^0.1.0",
    "@game-center/dpop-session-middleware": "jsr:@game-center/dpop-session-middleware@^0.1.0"
  },
  "permissions": {
    "default": {
      "env": [
        "IDP_ORIGIN",
        "RP_ORIGIN",
        "RP_SIGNING_KEY_JWK",
        "TURSO_DATABASE_URL",
        "PREVIEW_DATABASE_URL",
        "DENO_TIMELINE",
        "TURSO_AUTH_TOKEN"
      ],
      "net": true,
      "read": [
        "../bundled"
      ]
    }
  }
}
