{
  "tasks": {
    "bundle": "deno task --cwd ../bundler build",
    "dev": "deno task bundle && deno serve -P --watch ./router.ts",
    "serve": "deno serve -P ./router.ts"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom"],
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/ui"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@remix-run/ui": "npm:@remix-run/ui@^0.5.0",
    "@remix-run/fetch-router": "npm:@remix-run/fetch-router@0.21.0",
    "@remix-run/response": "npm:@remix-run/response@0.3.8",
    "@remix-run/static-middleware": "npm:@remix-run/static-middleware@0.4.13",
    "@libsql/client": "npm:@libsql/client@^0.17.4"
  },
  "permissions": {
    "default": {
      "env": [
        "IDP_ORIGIN",
        "RP_ORIGIN",
        "RP_SIGNING_KEY_JWK",
        "TURSO_DATABASE_URL",
        "TURSO_AUTH_TOKEN"
      ],
      "net": ["id.kbn.one", "*.turso.io", "localhost", "127.0.0.1"],
      "read": ["../bundled"]
    }
  }
}
